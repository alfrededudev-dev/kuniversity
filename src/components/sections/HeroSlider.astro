const slides = [
  {
    id: 1,
    title: "ADMISSIONS",
    subtitle: "ARE OPEN",
    tag: "Intake 2024-2025 👩‍🎓",
    description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum is simply dummy text of the printing and typesetting industry.",
    image: "/portrait-perfect-student-university.png",
    buttons: [
      { text: "Online Campus", variant: "primary-bordered" as const },
      { text: "Distance learning", variant: "accent-bordered" as const }
    ]
  },
  {
    id: 2,
    title: "ADMISSIONS",
    subtitle: "ARE OPEN",
    tag: "Intake 2024-2025 👩‍🎓",
    description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum is simply dummy text of the printing and typesetting industry.",
    image: "/Depositphotos_122104490_S.jpg",
    buttons: [
      { text: "Online Campus", variant: "primary-bordered" as const },
      { text: "Distance learning", variant: "accent-bordered" as const }
    ]
  },
  {
    id: 3,
    title: "ADMISSIONS",
    subtitle: "ARE OPEN",
    tag: "Intake 2024-2025 👩‍🎓",
    description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum is simply dummy text of the printing and typesetting industry.",
    image: "/portrait-perfect-student-university.png",
    buttons: [
      { text: "Online Campus", variant: "primary-bordered" as const },
      { text: "Distance learning", variant: "accent-bordered" as const }
    ]
  },
  {
    id: 4,
    title: "ADMISSIONS",
    subtitle: "ARE OPEN",
    tag: "Intake 2024-2025 👩‍🎓",
    description: "Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum is simply dummy text of the printing and typesetting industry.",
    image: "/Depositphotos_122104490_S.jpg",
    buttons: [
      { text: "Online Campus", variant: "primary-bordered" as const },
      { text: "Distance learning", variant: "accent-bordered" as const }
    ]
  },
];

const stats = [
  { amount: "25k", title: "library resource" },
  { amount: "+15400", title: "our graduates" },
