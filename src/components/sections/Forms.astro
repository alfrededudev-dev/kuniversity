---

<section class="forms">
  <div class="container">
    <div class="forms__content flex flex-col md:flex-row items-start justify-between gap-[28rem] max-md:gap-[18rem]">
      <!-- Image -->
      <div class="section-image section-image--left relative w-full md:w-[407rem] flex-shrink-0">
        <img
          src="/forms.png"
          alt="forms"
          class="w-full h-auto md:h-[450rem] md:w-[407rem] object-cover rounded-none"
        />
      </div>

      <!-- Content -->
      <div class="forms__info section-content flex-1 mt-0 md:mt-0">
        <h2 class="mb-[16rem] text-[38rem] font-bold uppercase leading-[44rem] max-md:mb-[10rem] max-md:text-center max-md:text-[18rem] max-md:leading-[21rem] max-md:mt-0">
          our students have the opportunity to choose the form of study
        </h2>

        <div class="forms__info__description section-content__description">
          <p class="mb-0 text-justify leading-[18rem]">
            Kyiv University is a <strong>modern educational institution</strong> that provides high-quality higher education. The university enjoys a well-deserved reputation as one of the leading universities not only in <strong>Ukraine</strong>.
          </p>
        </div>

        <div class="forms__list mt-[24rem]">
          {formsItems.map((item) => (
            <div class="forms-item mt-[24rem] flex items-start gap-[27rem] pl-[15rem] first:mt-0">
              <div class="forms-item__icon flex-shrink-0">
                <div class="h-[55rem] w-[55rem] [&>svg]:block [&>svg]:h-full [&>svg]:w-full">
                  <Fragment set:html={item.svg} />
                </div>
              </div>
              <div class="forms-item__content">
                <h3 class="mb-[16rem] text-[18rem] font-bold uppercase leading-[18rem] max-md:mb-[10rem] max-md:text-left max-md:text-[14rem]">{item.title}</h3>
                <p class="text-justify leading-[17rem]" set:html={item.description}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>