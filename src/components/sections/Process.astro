---

<div class="process">
  <div class="container">
    <div class="process__content relative flex items-start justify-between gap-[34rem] max-md:flex-col-reverse before:content-[''] before:absolute before:top-[-38rem] before:left-[-11rem] before:z-[-1] before:block before:h-[74rem] before:w-[74rem] before:rounded-[1.08rem] before:border-[3.3rem] before:border-primary/5 max-md:before:hidden after:content-[''] after:absolute after:top-[-50rem] after:left-[-26rem] after:z-[-1] after:block after:h-[43rem] after:w-[43rem] after:rounded-[1.08rem] after:border-[3.3rem] after:border-primary/5 max-md:after:hidden">
      
      <!-- Content -->
      <div class="process__info section-content mt-0 max-md:mt-0">
        <h2 class="mb-[16rem] text-[38rem] font-bold uppercase leading-[44rem] max-md:mb-[10rem] max-md:text-center max-md:text-[18rem] max-md:leading-[21rem] max-md:mt-0">
          Admission procces
        </h2>
        
        <div class="process__info__description section-content__description">
          <p class="mb-0 leading-[18rem] text-justify">
            Applying to university is a significant step in your life, opening up new horizons and opportunities for growth. This process can be exciting, but with the right approach and preparation, you can navigate it successfully. We are here to support you every step of the way on this exciting journey. <a href="#" class="font-bold italic text-accent/25 after:ml-[5rem] after:inline-block after:content-['→']">Read more</a>
          </p>
        </div>

        <div class="process__steps mt-[25rem] flex items-center justify-between max-md:flex-col">
          {steps.map((step) => (
            <div class="process-item relative border-r-[2rem] border-primary/10 px-[10rem] py-[50rem] max-md:border-b-[2rem] max-md:border-r-0 max-md:px-[10rem] max-md:py-[30rem] first:pl-[7rem] last:border-r-0 last:pr-[7rem] max-md:last:border-b-0">
              <div class="process-item__counter relative z-[-1] translate-y-[3rem] text-center text-[45rem] font-bold uppercase leading-[20rem] text-primary/25 max-md:text-[32rem]">
                <span class="process-item__counter-number text-[72rem] max-md:text-[46rem]">{step.number}</span>
                <span>Step</span>
              </div>
              
              <div class="process-item__content relative z-10 bg-white pt-[14rem] text-center">
                <h3 class="mb-[13rem] whitespace-nowrap text-[18rem] font-bold uppercase leading-[18rem] max-md:text-[14rem]">{step.title}</h3>
                <p class="px-[9rem] text-center leading-[18rem] max-md:leading-[13.8rem]">{step.description}</p>
                <div class="process-item__icon mt-[24rem] flex justify-center">
                  <Fragment set:html={step.svg} />
                </div>
              </div>
              
              <div class="shadow-box absolute right-[calc(50%-82.5rem)] top-[calc(50%-45rem)] z-[-2] h-[90rem] w-[165rem] shadow-[0_-4rem_30rem_0_rgba(0,69,98,0.12)] max-md:top-[calc(50%-30rem)]"></div>
            </div>
          ))}
        </div>
      </div>

      <!-- Image -->
      <div class="process__image section-image section-image--right relative w-full max-md:w-full
            after:content-[''] after:absolute after:right-[-1rem] after:bottom-[-20rem] after:z-[-1]
            after:h-[50rem] after:w-[50rem] after:rounded-[1.08rem] after:border-[2.4rem] after:border-primary/25">
  <img 
    src="/process.png" 
    alt="process" 
    class="h-[450rem] w-[407rem] object-cover max-md:h-[293rem] max-md:w-full"
  />
</div>
      
    </div>
  </div>
</div>