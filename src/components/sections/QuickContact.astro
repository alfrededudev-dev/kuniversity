---
// src/components/sections/QuickContact.astro
---

<section class="quick-contact mt-[37rem]">
  <div class="container">
    <div class="quick-contact__content flex flex-col md:flex-row items-start md:items-center gap-[4rem] md:gap-[40rem] justify-between px-0 md:px-[50rem]">
      <!-- Title: слева и ближе к инпутам на мобильных -->
      <div class="quick-contact__title text-[18rem] tracking-[0.72rem] uppercase whitespace-nowrap max-md:text-[9rem] max-md:text-left max-md:w-full">
        Complete The Form
      </div>
      
      <!-- Form: инпуты и кнопка на одной строке -->
      <form id="quickApplyForm" class="flex flex-row items-center gap-[8rem] md:gap-[26rem] w-full md:w-auto">
        <div class="inputs-group w-full md:w-[869rem] h-[32rem] flex items-center justify-between rounded-[3rem] bg-[#F8F8F8]/80 shadow-[inset_0_0_5rem_rgba(0,0,0,0.11)] max-md:h-[20rem]">
          <div class="inputs-group-item relative w-1/3">
            <input 
              type="text" 
              placeholder="Name*" 
              name="name"
              class="w-full h-[22rem] max-md:h-[14rem] border-r border-primary/50 bg-transparent pl-[12rem] font-serif text-[14rem] max-md:text-[9rem] text-primary/60 rounded-none placeholder:text-primary/60 placeholder:text-[14rem] max-md:placeholder:text-[9rem]"
            />
            <span class="absolute left-[5rem] text-[6rem] bottom-[-15rem] text-[#B10000]"></span>
          </div>
          <div class="inputs-group-item relative w-1/3">
            <input 
              type="text" 
              placeholder="Phone*" 
              name="phone" 
              id="phoneNumberField"
              class="w-full h-[22rem] max-md:h-[14rem] border-r border-primary/50 bg-transparent pl-[12rem] font-serif text-[14rem] max-md:text-[9rem] text-primary/60 rounded-none placeholder:text-primary/60 placeholder:text-[14rem] max-md:placeholder:text-[9rem]"
            />
            <span class="absolute left-[5rem] text-[6rem] bottom-[-15rem] text-[#B10000]"></span>
          </div>
          <div class="inputs-group-item relative w-1/3">
            <input 
              type="text" 
              placeholder="Email*" 
              name="email"
              class="w-full h-[22rem] max-md:h-[14rem] border-r-0 bg-transparent pl-[12rem] font-serif text-[14rem] max-md:text-[9rem] text-primary/60 rounded-none placeholder:text-primary/60 placeholder:text-[14rem] max-md:placeholder:text-[9rem]"
            />
            <span class="absolute left-[5rem] text-[6rem] bottom-[-15rem] text-[#B10000]"></span>
          </div>
        </div>
        
        <!-- Кнопка на одной строке с инпутами -->
        <div class="button-group relative w-[32rem] h-[32rem] max-md:w-[20rem] max-md:h-[20rem] flex-shrink-0">
          <button 
            type="submit"
            class="w-full h-full border-none rounded-[3rem] bg-primary hover:bg-accent transition-all duration-500 cursor-pointer flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" class="max-md:w-[8.75rem] max-md:h-[8.75rem]">
              <g clip-path="url(#clip0_4_196)">
                <path d="M13.7811 0.330073C13.953 0.45288 14.0233 0.616622 13.9921 0.821301L11.9921 12.6108C11.966 12.7592 11.8827 12.8743 11.7421 12.9562C11.6692 12.9971 11.5884 13.0176 11.4999 13.0176C11.4426 13.0176 11.3801 13.0048 11.3124 12.9792L7.19521 11.329L4.86708 13.8388C4.77333 13.9463 4.65094 14 4.4999 14C4.42698 14 4.36708 13.9898 4.32021 13.9693C4.22125 13.9335 4.14313 13.8734 4.08583 13.789C4.02854 13.7045 3.9999 13.6111 3.9999 13.5088V10.0395L0.312397 8.55814C0.119689 8.48651 0.0155222 8.34579 -0.000102796 8.13599C-0.0157278 7.93643 0.0676055 7.78548 0.249897 7.68314L13.2499 0.314722C13.4322 0.207266 13.6093 0.212383 13.7811 0.330073ZM11.1093 11.8356L12.8358 1.68095L1.63271 8.02854L4.25771 9.08007L10.9999 4.17547L7.26552 10.2928L11.1093 11.8356Z" fill="white"/>
              </g>
              <defs>
                <clipPath id="clip0_4_196">
                  <rect width="14" height="14" fill="white"/>
                </clipPath>
              </defs>
            </svg>
          </button>
          <span class="absolute font-italic text-[14rem] text-[#B10000] right-[-37rem] top-[7rem]"></span>
        </div>
      </form>
    </div>
  </div>
</section>