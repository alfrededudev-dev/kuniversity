      <div class="h-[20rem] w-[1.6rem] bg-white ml-[8rem] rounded-[1.6rem] flex-shrink-0"></div>
    </div>
  </a>

  <!-- To Top Button -->
  <button
    type="button"
    class="fixed-buttons-item fixed-buttons-item__to-top-button bg-primary rounded-[16rem_0_0_16rem] h-[32rem] max-md:h-[32rem] w-[54rem] max-md:w-[40rem] flex items-center pl-[8rem] cursor-pointer opacity-25 pointer-events-none transition-opacity duration-500"
    id="toTopButton"
    aria-label="Scroll to top"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0">
      <path d="M1.29672 10.896C1.49427 11.0935 1.76217 11.2045 2.0415 11.2045C2.32084 11.2045 2.58874 11.0935 2.78629 10.896L8.00086 5.68147L13.2154 10.896C13.4141 11.0879 13.6802 11.1941 13.9564 11.1917C14.2326 11.1893 14.4969 11.0785 14.6922 10.8832C14.8875 10.6879 14.9983 10.4237 15.0007 10.1475C15.0031 9.87125 14.8969 9.60514 14.705 9.40646L8.74565 3.44711C8.5481 3.24962 8.2802 3.13867 8.00086 3.13867C7.72152 3.13867 7.45362 3.24962 7.25607 3.44711L1.29672 9.40646C1.09923 9.60401 0.988281 9.87191 0.988281 10.1512C0.988281 10.4306 1.09923 10.6985 1.29672 10.896Z" fill="white"/>
    </svg>
    <div class="h-[20rem] w-[1.6rem] bg-white ml-[8rem] rounded-[1.6rem] flex-shrink-0"></div>
  </button>
</div>

<script>
  function initFixedButtons() {
    const toTopButton = document.getElementById('toTopButton');
    if (!toTopButton) return;

    if (toTopButton.dataset.bound === 'true') return;
    toTopButton.dataset.bound = 'true';

    const setVisible = (visible: boolean): void => {
      toTopButton.classList.toggle('opacity-25', !visible);
      toTopButton.classList.toggle('pointer-events-none', !visible);
    };

    const onScroll = (): void => {
      setVisible(window.scrollY > 300);
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    toTopButton.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    setVisible(window.scrollY > 300);
  }

  initFixedButtons();
  document.addEventListener('astro:page-load', initFixedButtons);
</script>