---
import "../styles/global.css";
import { SEO } from "astro-seo";

interface Props {
	title?: string;

	seoTitle?: string;
  	seoDescription?: string;
  	seoKeywords?: string[];

  	ogImage?: string;
  	noIndex?: boolean;
	children: any;
}

const {
  seoTitle,
  seoDescription = "Сайт создан с помощью современного шаблона Astro",
  seoKeywords = [],
  ogImage = "/default-og-image.jpg",
  noIndex = false,
  children
} = Astro.props;

const keywordsString = seoKeywords.join(', ');


const { title } = Astro.props;
const pageTitle = title ?? "Site";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<SEO
			title={title}
			description={seoDescription}
			noindex={noIndex}

			extend={{
				meta: [
				...(seoKeywords.length > 0 ? [
					{ name: "keywords", content: keywordsString }
				] : []),
				],
				link: [
				{ rel: "icon", href: "/favicon.ico" },
				{ rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
				]
			}}
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<script>
			const setHtmlFontSize = (width: number) => document.documentElement.style.fontSize = `${1 * window.innerWidth / width}px`
			const updateHtmlFontSize = () => window.innerWidth >= 992 ? setHtmlFontSize(1440) : setHtmlFontSize(360)
			updateHtmlFontSize();
			window.addEventListener('resize', updateHtmlFontSize);
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		font-size: 14rem;
	}
</style>
