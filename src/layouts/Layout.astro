<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<script>
			const setHtmlFontSize = (width: number) => document.documentElement.style.fontSize = `${1 * window.innerWidth / width}px`
			const updateHtmlFontSize =() =>  window.innerWidth >= 992 ? setHtmlFontSize(1440) :  setHtmlFontSize(360)
			updateHtmlFontSize();
			window.addEventListener('resize', updateHtmlFontSize);
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		font-size: 14rem;
		margin: 5px;
		width: 100%;
		height: 100%;
	}
</style>
