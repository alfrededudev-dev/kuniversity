---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const pageTitle = title ?? "Site";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<script>
			const setHtmlFontSize = (width: number) => document.documentElement.style.fontSize = `${1 * window.innerWidth / width}px`
			const updateHtmlFontSize = () => window.innerWidth >= 992 ? setHtmlFontSize(1440) : setHtmlFontSize(360)
			updateHtmlFontSize();
			window.addEventListener('resize', updateHtmlFontSize);
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		font-size: 14rem;
	}
</style>
